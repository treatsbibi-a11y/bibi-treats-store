{
  "name": "bibi-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-wrangler-env.mjs && node --no-node-snapshot ./node_modules/next/dist/bin/next dev -H 0.0.0.0",
    "build": "prisma generate && node --no-node-snapshot ./node_modules/next/dist/bin/next build",
    "pages:build": "npx @cloudflare/next-on-pages",
    "start": "node scripts/sync-wrangler-env.mjs && node --no-node-snapshot ./node_modules/next/dist/bin/next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed.mjs",
    "sync:backup": "node scripts/sync-and-backup-d1.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.18",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "next": "14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.167.0"
  }
}
